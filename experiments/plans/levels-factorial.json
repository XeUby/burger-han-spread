  "unit": "Three unique seed blocks. Each block is repeated across three levels and four policies. Thirty-six worlds are not thirty-six independent weeks. Level2/3 share worlds and are not substituted for independent evidence.",
  "contrasts": {
    "economics": "Changes fee assumption, driver pay and quote floor together; removes trust premium absent belowlevel8. This does not isolate a pure payment effect.",
    "admission": "Changes regional daily capacity, backlog, same-day capacity, route length and minimum supply together.",
    "interaction": "coupled - economics - admission + control, calculated within each level and seed.",
    "levelSelection": "Levels1,4,7 are distinct mechanism regimes: price ignored; competitive quotes with abundant supply; competitive quotes with scarce supply. Results do not validate omitted levels2,3,5,6."
  },
  "hypotheses": [
    {
      "name": "economic mismatch",
      "mechanism": "Lower the public typical-fee estimate and resulting customer quote floor in a world where there is ample driver supply; belowlevel8 do not price in a trust bonus that does not exist.",
      "falsifiedBy": "Economics arm fails to increase net margin, or lower pay increases late rescue cost/refunds enough to erase it."
    },
    {
      "name": "admission bottleneck",
      "mechanism": "Broaden the scarcity limits to admit viable jobs that the level8 controller rejects.",
      "falsifiedBy": "Extra admitted work lowers profit or reliability, or brings negligible throughput."
    },
    {
      "name": "complementarity",
      "mechanism": "Broader admission creates volume while lower pay and quotes make those jobs profitable.",
      "falsifiedBy": "Coupled gain fails to exceed the sum of separate gains, or qualification fails. A positive interaction alone is not a promotion criterion."
    }
  ],
  "screeningGatePerLevel": {
    "meanPairedGainEurosAtLeast": 1500,
    "minimumPairedGainEurosAtLeast": 0,
    "allWeeksQualified": true,
    "minimumWeeklyOnTimeShare": 0.92,
    "undeliveredOrders": 0,
    "failedVisits": 0
  },
  "selection": "Complete all36trials and retain every result. No parameter tuning inside panel. Candidate eligibility requires all screen gates at the relevant level; choose highest mean net gain among passing predeclared variants, tie by higher worst on-time share. Development selection is exploratory, not confirmatory. No pooling strong abundant-level gains to conceal a shortage-level loss.",
  "independentValidation": "A selected candidate requires a new complete frozen untouched panel under experiments/search-integrity.json before any promotion. Validation must cover each intended level; a small favorable level subset cannot authorize alllevels. No standards relaxed to fit09:00 cutoff.",
  "deadline": "No further ranking based on this development panel; no ranked action after2026-11-14T07:00:00Z. Unranked development may continue after deadline.",
  "interruptions": "Retain attempted failures; stop new creates on runner error. No poor-week deletion or silent replacement.",
